---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { compareArticles } from '../../utils/articleOrder';
import { isLive } from '../../utils/drafts';
import { renderInlineHtml } from '../../utils/summary';

const slug = Astro.params.slug ?? '';
const author = await getEntry('authors', slug);

if (!author || author.data.hasOwnPage === false) {
  Astro.response.status = 404;
}

// Articles marked listed: false, and drafts on the live site, are left out of every listing.
const allArticles = (await getCollection('articles', ({ data }) => data.listed !== false)).filter(
  isLive,
);

const columnLabelMap: Record<string, string> = {
  'Musings from the Corner Office': 'Corner Office',
  'Health/Vitality': 'Living Well',
};

const getDisplayEyebrow = () => {
  if (author?.data.column && columnLabelMap[author.data.column]) {
    return columnLabelMap[author.data.column];
  }

  if (author?.data.column) {
    return author.data.column;
  }

  return author?.data.pillars?.[0] ?? 'Sokéfi';
};

const getDisplayMonogram = () => {
  if (author?.data.monogram && author.data.monogram.trim()) {
    return author.data.monogram.trim().toUpperCase();
  }

  const initials = (author?.data.name ?? '')
    .split(/\s+/)
    .filter(Boolean)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('')
    .slice(0, 2);

  return initials || 'SO';
};

const authorArticles = allArticles
  // `author` is a collection reference ({ id, collection }), not a string.
  .filter((article) => author && article.data.author.id === author.id)
  .sort(compareArticles);

const eyebrow = getDisplayEyebrow();
const monogram = getDisplayMonogram();
// Bio with the same curly quotes and dashes as body copy.
const bioHtml = await renderInlineHtml(author?.data.shortBio ?? '');
const authorRole = author?.id === 'charlotte-mowbray-greene' ? 'Editor in Chief' : '';
---

<Base
  title={author ? `${author.data.name} — Sokéfi` : 'Author not found — Sokéfi'}
  description={author?.data.shortBio ?? 'This author could not be found.'}
>
  <main>
    {
      author ? (
        <>
          <section class="section author-intro" aria-labelledby="author-name">
            <div class="author-monogram" aria-hidden="true">
              {monogram}
            </div>
            <div class="author-copy">
              <p class="author-eyebrow">{eyebrow}</p>
              <h1 class="author-name" id="author-name">
                {author.data.name}
              </h1>
              {authorRole && <p class="author-role">{authorRole}</p>}
              <p class="author-bio" set:html={bioHtml} />
            </div>
          </section>

          {/* An author with no articles yet shows no article section at all. */}
          {authorArticles.length > 0 && (
            <>
              <div class="author-divider" aria-hidden="true" />

              <section class="author-feed" aria-labelledby="author-feed-title">
                <h2 id="author-feed-title">Articles by {author.data.name.split(' ')[0]}</h2>

                <div class="feed-list">
                  {authorArticles.map((article) => (
                    <ArticleCard article={article} />
                  ))}
                </div>
              </section>
            </>
          )}
        </>
      ) : (
        <section class="section" aria-labelledby="author-missing-title">
          <h1 id="author-missing-title">Author not found</h1>
          <p>This author profile could not be found.</p>
        </section>
      )
    }
  </main>
</Base>

<style>
  .author-intro {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(1rem, 2.6vw, 1.75rem);
  }

  .author-monogram {
    width: clamp(5rem, 10vw, 6.5rem);
    height: clamp(5rem, 10vw, 6.5rem);
    border-radius: 50%;
    background: var(--brand-teal);
    color: #f7f4ef;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Lato', Arial, sans-serif;
    font-size: clamp(1.45rem, 2.5vw, 1.95rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }

  .author-copy {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .author-eyebrow {
    margin: 0;
    font-family: 'Lato', Arial, sans-serif;
    color: #c9a227;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .author-name {
    margin: 0;
    font-family: 'Playfair Display', Georgia, serif;
    color: var(--brand-teal);
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.1;
  }

  .author-bio {
    margin: 0;
    color: #2a3c41;
    font-size: 1.08rem;
    line-height: 1.5;
  }

  .author-role {
    margin: 0;
    color: var(--brand-teal);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: none;
  }

  .author-divider {
    height: 1.5px;
    margin: 0.35rem 0 1.5rem;
    background: #c9a227;
  }

  .author-feed h2 {
    margin: 0 0 1rem;
    color: var(--brand-teal);
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
  }

  .feed-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (max-width: 700px) {
    .author-intro {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
