---
import Base from '../layouts/Base.astro';
import reservationSelfieHat from '../assets/images/reservation-selfie-hat.webp';
import { getCollection, getEntry } from 'astro:content';
import { getThumbnailSrc } from '../utils/pillarFallback';
import { getAuthorRoute } from '../config/routes';

const allArticles = await getCollection('articles');
const allAuthors = await getCollection('authors');
const authorEntry = await getEntry('authors', 'sophie-westbrooke');

const normalizePillar = (pillar) =>
  (pillar ?? '').toLowerCase().replace(/\s+/g, '-').replace(/-+/g, '-');

const getArticleDateValue = (article) => {
  const rawDate = article.data.updatedDate ?? article.data.date;
  const parsedDate = rawDate ? new Date(rawDate) : null;
  return parsedDate ? parsedDate.getTime() : 0;
};

const authorNameMap = Object.fromEntries(allAuthors.map((author) => [author.id, author.data.name]));

const reservationArticles = allArticles
  .filter((article) => normalizePillar(article.data.pillar) === 'reservation-for-one')
  .sort((a, b) => getArticleDateValue(b) - getArticleDateValue(a));

const featuredArticles = reservationArticles.filter((article) => article.data.featured);
const standardArticles = reservationArticles.filter((article) => !article.data.featured);
const orderedArticles = [...featuredArticles, ...standardArticles];

const bioText = 'The original modern nomad — travelling solo since her twenties.';
const authorName = authorEntry?.data.name ?? 'Sophie Westbrooke';
---

<Base title="Reservation for One — Sokéfi">
  <main>
    <section class="pillar-header-card" aria-labelledby="reservation-title">
      <div class="pillar-header-media">
        <img
          src={reservationSelfieHat.src}
          alt="A woman in a tan fedora hat photographing a neon-lit night market street on her phone, with a backpack visible and a tuk-tuk in the background."
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="pillar-header-text">
        <p class="pillar-eyebrow">Sokéfi</p>
        <h1 class="pillar-title" id="reservation-title">Reservation for One</h1>
        <p class="pillar-tagline">{'The intentional' + String.fromCharCode(160) + 'adventure.'}</p>
      </div>
    </section>

    <section class="feed-section" aria-labelledby="reservation-feed-title">
      <div class="section-heading">
        <div>
          <p class="section-label">The latest from Reservation for One</p>
          <h2 id="reservation-feed-title">Editorial dispatches</h2>
        </div>
      </div>

      {
        orderedArticles.length > 0 ? (
          <div class="feed-list">
            {orderedArticles.map((article) => {
              const thumbnailSrc = getThumbnailSrc(article);
              const byline =
                article.data.byline || authorNameMap[article.data.author.id] || 'Sokéfi';

              return (
                <article class:list={['feed-card', article.data.featured && 'feed-card-featured']}>
                  {thumbnailSrc && (
                    <img
                      class="feed-card-image"
                      src={thumbnailSrc}
                      alt={article.data.title}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <div class="feed-card-body">
                    <p class="feed-card-eyebrow">{article.data.eyebrow || 'Reservation for One'}</p>
                    <p class="feed-card-byline">{byline}</p>
                    <h3 class="feed-card-title">{article.data.title}</h3>
                    <p class="feed-card-dek">
                      {article.data.dek || article.data.description || article.data.metaDescription}
                    </p>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="feed-empty-state">
            <p>No articles are currently assigned to this pillar.</p>
          </div>
        )
      }
    </section>

    <section class="editor-bio-bar" aria-label="Editor bio">
      <a class="editor-bio-link" href={getAuthorRoute('sophie-westbrooke')}>
        <div class="editor-bio-copy">
          <p class="editor-bio-eyebrow">RESERVATION FOR ONE</p>
          <p class="editor-bio-name">{authorName}</p>
          <p class="editor-bio-text">{bioText}</p>
        </div>
      </a>
    </section>
  </main>
</Base>

<style>
  .feed-section {
    padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1.25rem, 3.6vw, 2.35rem) 0;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .section-label {
    margin: 0 0 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.76rem;
    color: #0c7fa2;
    font-weight: 700;
  }

  .feed-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .feed-card {
    display: grid;
    grid-template-columns: minmax(180px, 240px) 1fr;
    gap: 1rem;
    padding: 1rem;
    background: #fff;
    border: 1px solid rgba(14, 143, 184, 0.16);
    border-radius: 0;
    box-shadow: none;
  }

  .feed-card-featured {
    border-color: rgba(201, 162, 39, 0.45);
    background: #fdf8eb;
    transform: translateY(-1px);
  }

  .feed-card-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border-radius: 0;
    border: 1px solid rgba(14, 143, 184, 0.16);
  }

  .feed-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .feed-card-eyebrow,
  .feed-card-byline,
  .feed-card-dek {
    margin: 0;
    color: #46565b;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .feed-card-eyebrow {
    color: #0c7fa2;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .feed-card-title {
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.2;
    color: #17272b;
  }

  .feed-empty-state {
    padding: 0;
    border: 0;
    background: transparent;
    color: #46565b;
    font-style: italic;
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .editor-bio-bar {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    align-items: center;
    padding: 1.2rem 1.75rem;
    border: 0;
    background: #1a5f6e;
    border-radius: 0;
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .editor-bio-copy {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    position: relative;
    padding-left: 0.55rem;
  }

  .editor-bio-link {
    text-decoration: none;
    color: inherit;
  }

  .editor-bio-copy::before {
    content: '';
    position: absolute;
    top: 0.1rem;
    left: 0;
    width: 2px;
    height: calc(100% - 0.2rem);
    background: #c9a227;
  }

  .editor-bio-eyebrow {
    margin: 0 0 0.2rem;
    color: #c9a227;
    opacity: 1;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.9rem;
    font-weight: 800;
  }

  .editor-bio-name {
    margin: 0;
    font-weight: 700;
    color: #f7f4ef;
  }

  .editor-bio-text {
    margin: 0;
    color: #f7f4ef;
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .feed-card {
      grid-template-columns: 1fr;
    }

    .feed-card-image {
      max-width: 220px;
    }
  }
</style>
