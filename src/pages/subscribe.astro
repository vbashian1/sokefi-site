---
import Base from '../layouts/Base.astro';
---

<Base title="Subscribe — Sokéfi">
  <main>
    <section class="pillar-header-card" aria-labelledby="subscribe-title">
      <div class="pillar-header-text">
        <p class="pillar-eyebrow">Sokéfi</p>
        <h1 class="pillar-title" id="subscribe-title">Subscribe</h1>
        <p class="pillar-tagline">Coming soon.</p>
      </div>
    </section>

    <section class="section pillar-intro" aria-label="Subscribe content">
      <div class="pillar-intro-text">
        <p>
          Sign-up for The Sokéfi Edit newsletter isn't live yet. Check back soon, or reach us
          directly at <a href="mailto:hello@sokefi.com">hello@sokefi.com</a>.
        </p>
      </div>
    </section>
  </main>
</Base>
