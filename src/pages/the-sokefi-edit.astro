---
import Base from '../layouts/Base.astro';
---

<Base title="The Sokéfi Edit — Sokéfi">
  <main>
    <section class="pillar-header-card" aria-labelledby="edit-title">
      <div class="pillar-header-text">
        <p class="pillar-eyebrow">Sokéfi</p>
        <h1 class="pillar-title" id="edit-title">The Sokéfi Edit</h1>
        <p class="pillar-tagline">Coming soon.</p>
      </div>
    </section>

    <section class="section pillar-intro" aria-label="The Sokéfi Edit content">
      <div class="pillar-intro-text">
        <p>
          The Sokéfi Edit, our roundup of the latest editorial picks across Awenvida, Beyond the
          Guidebook, The Uncommon Traveller, and Reservation for One, is on its way. Check back
          soon.
        </p>
      </div>
    </section>
  </main>
</Base>
