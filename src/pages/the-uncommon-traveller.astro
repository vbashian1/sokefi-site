---
import Base from '../layouts/Base.astro';
import PillarArticles from '../components/PillarArticles.astro';
import PillarEditors from '../components/PillarEditors.astro';
import { getAuthorRoute } from '../config/routes';
import uncommonLanterns from '../assets/images/uncommon-lanterns.webp';
---

<Base title="The Uncommon Traveller — Sokéfi">
  <main>
    <section class="pillar-header-card" aria-labelledby="traveller-title">
      <div class="pillar-header-media">
        <img
          src={uncommonLanterns.src}
          alt="Rows of hanging paper lanterns with Japanese text in a warm lit interior, with no person in frame."
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="pillar-header-text">
        <p class="pillar-eyebrow">Sokéfi</p>
        <h1 class="pillar-title" id="traveller-title">The Uncommon Traveller</h1>
        <p class="pillar-tagline">
          {'Wander intelligently. Live' + String.fromCharCode(160) + 'curiously.'}
        </p>
      </div>
    </section>

    <PillarArticles pillar="The Uncommon Traveller" />

    <PillarEditors
      label="The Uncommon Traveller team"
      editors={[
        {
          eyebrow: 'The Uncommon Traveller',
          name: 'Sokéfi Editorial Team',
          href: getAuthorRoute('sokefi-editorial-team'),
          more: 'the team',
        },
      ]}
    />
  </main>
</Base>
