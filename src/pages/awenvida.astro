---
import Base from '../layouts/Base.astro';
import awenvidaBalcony from '../assets/images/awenvida-breakfast-balcony.avif';
import { getAuthorRoute } from '../config/routes';
import PillarArticles from '../components/PillarArticles.astro';
import PillarEditors from '../components/PillarEditors.astro';
---

<Base title="Awenvida — Sokéfi">
  <main>
    <section class="pillar-header-card awenvida-header-card" aria-labelledby="awenvida-title">
      <div class="pillar-header-media">
        <img
          src={awenvidaBalcony.src}
          alt="A breakfast table on an ocean-view balcony seen through a window frame, with wicker chairs and a wooden ceiling beam overhead."
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="pillar-header-text">
        <p class="pillar-eyebrow">Sokéfi</p>
        <h1 class="pillar-title" id="awenvida-title">Awenvida</h1>
        <p class="pillar-tagline">{'The inspired' + String.fromCharCode(160) + 'life.'}</p>
        <p class="awenvida-etymology">
          Awenvida is a word we coined ourselves — awen, Cornish for inspiration, and vida, life.
          Together: a life lived inspired.
        </p>
      </div>
    </section>

    <PillarArticles pillar="Awenvida" />

    <PillarEditors
      label="Awenvida editors"
      editors={[
        {
          eyebrow: 'Living Well',
          name: 'Alice Wellesley',
          href: getAuthorRoute('alice-wellesley'),
          more: 'Alice',
        },
        {
          eyebrow: "Jake's Take",
          name: 'Jake Martin',
          href: getAuthorRoute('jake-martin'),
          more: 'Jake',
        },
        {
          eyebrow: 'Corner Office',
          name: 'Charlotte Mowbray-Greene',
          href: getAuthorRoute('charlotte-mowbray-greene'),
          more: 'Charlotte',
        },
      ]}
    />
  </main>
</Base>

<style>
  .awenvida-header-card .pillar-header-media img {
    object-position: center 77%;
  }

  .awenvida-etymology {
    margin: 1rem 0 0;
    padding-left: 0.85rem;
    position: relative;
    color: color-mix(in srgb, var(--brand-teal) 85%, transparent);
    font-family: 'Playfair Display', Georgia, serif;
    font-style: normal;
    font-size: clamp(1rem, 1.65vw, 1.1rem);
    line-height: 1.45;
  }

  .awenvida-etymology::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.2rem;
    width: 2px;
    height: calc(100% - 0.4rem);
    background: #c9a227;
  }
</style>
