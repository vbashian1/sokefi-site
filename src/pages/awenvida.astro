---
import Base from '../layouts/Base.astro';
import awenvidaBalcony from '../assets/images/awenvida-breakfast-balcony.avif';
import { getAuthorRoute } from '../config/routes';
---

<Base title="Awenvida — Sokéfi">
  <main>
    <section class="pillar-header-card awenvida-header-card" aria-labelledby="awenvida-title">
      <div class="pillar-header-media">
        <img
          src={awenvidaBalcony.src}
          alt="A breakfast table on an ocean-view balcony seen through a window frame, with wicker chairs and a wooden ceiling beam overhead."
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="pillar-header-text">
        <p class="pillar-eyebrow">Sokéfi</p>
        <h1 class="pillar-title" id="awenvida-title">Awenvida</h1>
        <p class="pillar-tagline">{'The inspired' + String.fromCharCode(160) + 'life.'}</p>
        <p class="awenvida-etymology">
          Awenvida is a word we coined ourselves — awen, Cornish for inspiration, and vida, life.
          Together: a life lived inspired.
        </p>
      </div>
    </section>

    <section class="awenvida-bio-bar" aria-label="Awenvida contributors">
      <a class="awenvida-bio-lane" href={getAuthorRoute('alice-wellesley')}>
        <p class="awenvida-bio-eyebrow">Living Well</p>
        <p class="awenvida-bio-name">Alice Wellesley</p>
      </a>
      <a class="awenvida-bio-lane" href={getAuthorRoute('jake-martin')}>
        <p class="awenvida-bio-eyebrow">Jake's Take</p>
        <p class="awenvida-bio-name">Jake Martin</p>
      </a>
      <a class="awenvida-bio-lane" href={getAuthorRoute('charlotte-mowbray-greene')}>
        <p class="awenvida-bio-eyebrow">Corner Office</p>
        <p class="awenvida-bio-name">Charlotte Mowbray-Greene</p>
      </a>
    </section>
  </main>
</Base>

<style>
  .awenvida-header-card .pillar-header-media img {
    object-position: center 77%;
  }

  .awenvida-etymology {
    margin: 1rem 0 0;
    padding-left: 0.85rem;
    position: relative;
    color: color-mix(in srgb, var(--brand-teal) 85%, transparent);
    font-family: 'Playfair Display', Georgia, serif;
    font-style: normal;
    font-size: clamp(1rem, 1.65vw, 1.1rem);
    line-height: 1.45;
  }

  .awenvida-etymology::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.2rem;
    width: 2px;
    height: calc(100% - 0.4rem);
    background: #c9a227;
  }

  .awenvida-bio-bar {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    background: var(--brand-teal);
  }

  .awenvida-bio-lane {
    margin: 0;
    padding: 1.2rem 1.75rem;
    position: relative;
    text-decoration: none;
  }

  .awenvida-bio-lane:not(:first-child)::before {
    content: '';
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: 0;
    width: 2px;
    background: #c9a227;
  }

  .awenvida-bio-eyebrow {
    margin: 0 0 0.35rem;
    color: #c9a227;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .awenvida-bio-name {
    margin: 0;
    color: #f7f4ef;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .awenvida-bio-bar {
      grid-template-columns: 1fr;
    }

    .awenvida-bio-lane {
      border-left: 0;
      border-top: 2px solid #c9a227;
    }

    .awenvida-bio-lane:first-child {
      border-top: 0;
    }
  }
</style>
