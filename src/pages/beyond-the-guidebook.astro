---
import Base from '../layouts/Base.astro';
import PillarArticles from '../components/PillarArticles.astro';
import PillarEditors from '../components/PillarEditors.astro';
import { getAuthorRoute } from '../config/routes';
import beyondCamels from '../assets/images/beyond-camels-stable.webp';
import { responsiveImage, SLOTS } from '../utils/responsiveImage';
---

<Base title="Beyond the Guidebook — Sokéfi">
  <main>
    <section class="pillar-header-card" aria-labelledby="guidebook-title">
      <div class="pillar-header-media">
        <img
          {...responsiveImage(beyondCamels, SLOTS.pillarHeader())}
          alt="A camel caravan led by a walking guide in the desert with strong sun flare and long shadows on the sand."
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="pillar-header-text">
        <p class="pillar-eyebrow">Sokéfi</p>
        <h1 class="pillar-title" id="guidebook-title">Beyond the Guidebook</h1>
        <p class="pillar-tagline">The world. Seen differently.</p>
      </div>
    </section>

    <PillarArticles pillar="Beyond the Guidebook" />

    <PillarEditors
      label="Beyond the Guidebook team"
      editors={[
        {
          eyebrow: 'Beyond the Guidebook',
          name: 'Sokéfi Editorial Team',
          href: getAuthorRoute('sokefi-editorial-team'),
          more: 'the team',
        },
      ]}
    />
  </main>
</Base>
