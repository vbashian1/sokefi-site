---
import Base from '../layouts/Base.astro';
import uncommonLanterns from '../assets/images/uncommon-lanterns.webp';
---

<Base title="The Uncommon Traveller — Sokéfi">
  <main>
    <section class="pillar-header-card" aria-labelledby="traveller-title">
      <div class="pillar-header-media">
        <img
          src={uncommonLanterns.src}
          alt="Rows of hanging paper lanterns with Japanese text in a warm lit interior, with no person in frame."
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="pillar-header-text">
        <p class="pillar-eyebrow">Sokéfi</p>
        <h1 class="pillar-title" id="traveller-title">The Uncommon Traveller</h1>
        <p class="pillar-tagline">
          {'Wander intelligently. Live' + String.fromCharCode(160) + 'curiously.'}
        </p>
      </div>
    </section>

    <section class="pillar-team-bar" aria-label="Pillar team">
      <div class="pillar-team-copy">
        <p class="pillar-team-eyebrow">THE UNCOMMON TRAVELLER</p>
        <p class="pillar-team-name">Sokéfi Editorial Team</p>
      </div>
    </section>
  </main>
</Base>

<style>
  .pillar-team-bar {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    padding: 1.2rem 1.75rem;
    background: var(--brand-teal);
  }

  .pillar-team-copy {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    position: relative;
    padding-left: 0.55rem;
  }

  .pillar-team-copy::before {
    content: '';
    position: absolute;
    top: 0.1rem;
    left: 0;
    width: 2px;
    height: calc(100% - 0.2rem);
    background: #c9a227;
  }

  .pillar-team-eyebrow {
    margin: 0 0 0.2rem;
    color: #c9a227;
    opacity: 1;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.9rem;
    font-weight: 800;
  }

  .pillar-team-name {
    margin: 0;
    color: #f7f4ef;
    font-weight: 700;
  }
</style>
