---
// LOCAL PREVIEW ONLY (returns 404 on the live site): frame an article's photos by eye.
// The real article and card pages load in frames at reader screen widths. Sliders set each
// placement's focal point and zoom live in every frame; the page outlines on the original
// exactly what each width shows, warns when a zoom asks for more detail than the photo has,
// and prints the frontmatter values to send back. Nothing is saved from here.
import { getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { getAuthorRoute } from '../../../config/routes';
import ArticleGallery from '../../../components/ArticleGallery.astro';
import Inset from '../../../components/blocks/Inset.astro';

export const prerender = false;

const entry = import.meta.env.DEV ? await getEntry('articles', Astro.params.slug ?? '') : undefined;
if (!entry) return new Response('Not found', { status: 404 });

// With ?proposal=1 the in-article photos come from the proposed layout
// (src/proposals/<article>.mdx, or .<name>.mdx for ?proposal=<name>), so they can be framed
// before that layout is saved into the article.
const proposalSources = import.meta.glob('../../../proposals/*.mdx', {
  query: '?raw',
  import: 'default',
});
const proposalName = Astro.url.searchParams.get('proposal');
const proposalSource = Astro.url.searchParams.has('proposal')
  ? proposalSources[
      `../../../proposals/${entry.id}${proposalName && proposalName !== '1' ? `.${proposalName}` : ''}.mdx`
    ]
  : undefined;
const body = proposalSource ? ((await proposalSource()) as string) : (entry.body ?? '');

const articleUrl = `/articles/${entry.id}/`;
const authorUrl = getAuthorRoute(entry.data.author.id);

const parseFocus = (focus?: string) => {
  const [x, y] = (focus ?? '50% 50%').split(' ').map((v) => parseInt(v, 10));
  return { x, y };
};

// ?hero=<across>,<down>,<zoom> opens the banner at a proposed crop (e.g. ?hero=90,56,2), so
// a crop can be sent as a link (the reset button then returns to that crop).
const heroLink = Astro.url.searchParams.get('hero')?.split(',').map(Number);
const heroProposed =
  heroLink && heroLink.length >= 2 && heroLink.every((n) => Number.isFinite(n))
    ? heroLink
    : undefined;

const PLACEMENTS = [
  entry.data.heroImage && {
    id: 'hero',
    title: 'Article banner (hero)',
    image: entry.data.heroImage,
    focusField: 'heroFocus',
    zoomField: 'heroZoom',
    focus: heroProposed
      ? { x: heroProposed[0], y: heroProposed[1] }
      : parseFocus(entry.data.heroFocus),
    zoom: heroProposed?.[2] ?? entry.data.heroZoom ?? 1,
    saved: Boolean(entry.data.heroFocus),
    url: articleUrl,
    target: '.article-hero img',
    views: [
      { label: 'Desktop 1440px', width: 1440 },
      { label: 'Laptop 1024px', width: 1024 },
      { label: 'Tablet 768px', width: 768 },
      { label: 'Phone 390px', width: 390 },
    ],
  },
  entry.data.thumbnail && {
    id: 'thumbnail',
    title: 'Article card (thumbnail)',
    image: entry.data.thumbnail,
    focusField: 'thumbnailFocus',
    zoomField: 'thumbnailZoom',
    focus: parseFocus(entry.data.thumbnailFocus),
    zoom: entry.data.thumbnailZoom ?? 1,
    saved: Boolean(entry.data.thumbnailFocus),
    url: authorUrl,
    target: `.feed-card-image[alt="${entry.data.title.replace(/"/g, '\\"')}"]`,
    views: [
      { label: 'Desktop 1440px · author page card', width: 1440 },
      { label: 'Phone 390px · author page card', width: 390 },
    ],
  },
].filter((p): p is NonNullable<typeof p> => Boolean(p));

// In-article photos: one section per <Gallery pick={[n]} … /> marker in the article body,
// in reading order, with whatever framing that placement already has.
const ARTICLE_COLUMN = 680;
const SHAPE_CHOICES = [
  { value: 'original', label: 'Original' },
  { value: '3:2', label: 'Landscape 3:2' },
  { value: '4:3', label: 'Landscape 4:3' },
  { value: '1:1', label: 'Square' },
  { value: '4:5', label: 'Portrait 4:5' },
  { value: '16:9', label: 'Wide 16:9' },
  { value: '2:1', label: 'Wide 2:1' },
] as const;
const attr = (attrs: string, re: RegExp) => attrs.match(re)?.[1];
const galleryImages = entry.data.gallery ?? [];
// <Inset pick={n} … /> markers are included too (Veronica, 2026-10-23), drawn by the Inset
// component at its own width, and keep their side and size in the copied marker.
const placements = [...body.matchAll(/<(Gallery|Inset)\b([^>]*?)\/>/g)]
  .map((m, i) => {
    const inset = m[1] === 'Inset';
    const attrs = m[2];
    const pick = Number(attr(attrs, inset ? /pick=\{\s*(\d+)\s*\}/ : /pick=\{\[\s*(\d+)\s*\]\}/));
    const image = galleryImages[pick];
    if (!image) return null;
    return {
      n: i + 1,
      pick,
      inset,
      side: (attr(attrs, /side="([^"]+)"/) ?? 'left') as 'left' | 'right',
      size: (attr(attrs, /size="([^"]+)"/) ?? 'standard') as 'standard' | 'large',
      image,
      file: decodeURIComponent(image.src.split('?')[0].split('/').pop() ?? ''),
      shape: (attr(attrs, /shape="([^"]+)"/) ??
        'original') as (typeof SHAPE_CHOICES)[number]['value'],
      focus: parseFocus(attr(attrs, /focus="([^"]+)"/)),
      zoom: Number(attr(attrs, /zoom=\{([\d.]+)\}/) ?? 1),
    };
  })
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<Base title={`Framing — ${entry.data.title}`}>
  <main class="framing">
    <p class="framing-eyebrow">Local preview · not on the live site</p>
    <h1>Framing: {entry.data.title}</h1>
    <p class="framing-intro">
      Move the sliders to set each placement's focal point and zoom. Every frame below updates live;
      the outlines show exactly what each screen width shows of your original. When it looks right,
      copy the values and send them to me. Nothing here is saved.
    </p>
    {
      proposalSource && (
        <p class="framing-intro">In-article photos are placed as in the proposed layout.</p>
      )
    }

    {
      PLACEMENTS.map((p) => (
        <section
          class="framing-section"
          data-placement={p.id}
          data-focus-field={p.focusField}
          data-zoom-field={p.zoomField}
        >
          <h2>{p.title}</h2>
          {!p.saved && (
            <p class="framing-warning">
              No {p.focusField} saved yet: on the site this placement is centre-cropped.
            </p>
          )}

          <div class="framing-controls">
            <label>
              Focus across <output data-out="x">{p.focus.x}%</output>
              <input type="range" min="0" max="100" step="1" value={p.focus.x} data-control="x" />
            </label>
            <label>
              Focus down <output data-out="y">{p.focus.y}%</output>
              <input type="range" min="0" max="100" step="1" value={p.focus.y} data-control="y" />
            </label>
            <label>
              Zoom <output data-out="z">{p.zoom.toFixed(2)}×</output>
              <input type="range" min="1" max="3" step="0.01" value={p.zoom} data-control="z" />
            </label>
            <button type="button" data-reset>
              Back to saved values
            </button>
          </div>

          <div class="framing-values">
            <pre data-values />
            <button type="button" data-copy>
              Copy values
            </button>
          </div>

          <div
            class="framing-original"
            data-saved-x={p.focus.x}
            data-saved-y={p.focus.y}
            data-saved-z={p.zoom}
          >
            <img src={p.image.src} width={p.image.width} height={p.image.height} alt="" />
            <div class="framing-overlay" />
          </div>
          <p class="framing-meta">
            Original: {p.image.width} × {p.image.height} pixels
          </p>
          <ul class="framing-legend" />

          <div class="framing-views">
            {p.views.map((view, i) => (
              <figure class="framing-view">
                <figcaption>{view.label}</figcaption>
                <div class="framing-frame" style={`--w: ${view.width}`}>
                  <iframe
                    src={p.url}
                    width={view.width}
                    height="760"
                    data-view={view.label}
                    data-index={i}
                    data-target={p.target}
                    data-scroll-to={p.id === 'thumbnail' ? 'true' : undefined}
                    title={view.label}
                  />
                </div>
              </figure>
            ))}
          </div>
        </section>
      ))
    }

    {
      placements.length > 0 && (
        <>
          <h2 class="framing-part">In-article photos</h2>
          <p class="framing-intro">
            One section per photo placement, in reading order. Choose a shape, then set the focal
            point and zoom. The photo below each set of controls is drawn by the site's own gallery
            component at the article column width ({ARTICLE_COLUMN}px). Copy the marker line and
            send it to me; it replaces that placement's marker in the article.
          </p>
        </>
      )
    }
    {
      placements.map((g) => (
        <section
          class="framing-section framing-gallery"
          data-pick={g.pick}
          data-saved-shape={g.shape}
          data-inset={g.inset ? `${g.side},${g.size}` : undefined}
        >
          <h2>
            Photo {g.n}: {g.file}
            {g.inset && ` (inset, ${g.side}${g.size === 'large' ? ', large' : ''})`}
          </h2>

          <fieldset class="framing-shapes">
            <legend>Shape</legend>
            {SHAPE_CHOICES.map((s) => (
              <label>
                <input
                  type="radio"
                  name={`shape-${g.n}`}
                  value={s.value}
                  checked={s.value === g.shape}
                  data-shape
                />
                {s.label}
              </label>
            ))}
          </fieldset>

          <div class="framing-controls">
            <label>
              Focus across <output data-out="x">{g.focus.x}%</output>
              <input type="range" min="0" max="100" step="1" value={g.focus.x} data-control="x" />
            </label>
            <label>
              Focus down <output data-out="y">{g.focus.y}%</output>
              <input type="range" min="0" max="100" step="1" value={g.focus.y} data-control="y" />
            </label>
            <label>
              Zoom <output data-out="z">{g.zoom.toFixed(2)}×</output>
              <input type="range" min="1" max="3" step="0.01" value={g.zoom} data-control="z" />
            </label>
            <button type="button" data-reset>
              Back to saved values
            </button>
          </div>

          <div class="framing-values">
            <pre data-values />
            <button type="button" data-copy>
              Copy marker
            </button>
          </div>

          <div class="framing-gallery-layout">
            <div>
              <div
                class="framing-original framing-original-small"
                data-saved-x={g.focus.x}
                data-saved-y={g.focus.y}
                data-saved-z={g.zoom}
              >
                <img src={g.image.src} width={g.image.width} height={g.image.height} alt="" />
                <div class="framing-overlay" />
              </div>
              <p class="framing-meta">
                Original: {g.image.width} × {g.image.height} pixels
              </p>
              <ul class="framing-legend" />
            </div>
            <div class="framing-column">
              <p class="framing-column-label">
                {g.inset
                  ? `As an inset beside the text, in the article column (${ARTICLE_COLUMN}px)`
                  : `In the article column (${ARTICLE_COLUMN}px)`}
              </p>
              {g.inset ? (
                <Inset
                  image={g.image}
                  side={g.side}
                  size={g.size}
                  shape={g.shape}
                  focus={`${g.focus.x}% ${g.focus.y}%`}
                  zoom={g.zoom}
                />
              ) : (
                <ArticleGallery
                  images={[g.image]}
                  shape={g.shape}
                  focus={`${g.focus.x}% ${g.focus.y}%`}
                  zoom={g.zoom}
                />
              )}
            </div>
          </div>
        </section>
      ))
    }
  </main>
</Base>

<script>
  const COLOURS = ['#1a5f6e', '#c9a227', '#b04a2f', '#5b4a9e'];
  const pct = (n: number) => `${Math.round(n * 1000) / 10}%`;

  interface Framing {
    x: number;
    y: number;
    z: number;
  }

  /**
   * Which part of the original an <img> shows, as fractions of the photo, plus how many
   * photo pixels land on each screen pixel (for the sharpness check). Matches the site CSS:
   * object-fit cover at the focal point, then scale(zoom) around that same point; phones
   * use object-fit contain (the whole photo).
   */
  const visibleArea = (img: HTMLImageElement, f: Framing) => {
    const style = getComputedStyle(img);
    const boxW = img.offsetWidth;
    const boxH = img.offsetHeight;
    // Fall back to the size attributes: lazy-loaded photos may not have loaded yet.
    const nw = img.naturalWidth || Number(img.getAttribute('width'));
    const nh = img.naturalHeight || Number(img.getAttribute('height'));
    if (style.objectFit !== 'cover') {
      const scale = Math.min(boxW / nw, boxH / nh);
      return { left: 0, top: 0, width: 1, height: 1, density: 1 / scale, whole: true };
    }
    const zoom = style.transform === 'none' ? 1 : f.z;
    const scale = Math.max(boxW / nw, boxH / nh);
    const w = boxW / scale / nw;
    const h = boxH / scale / nh;
    const fx = f.x / 100;
    const fy = f.y / 100;
    const left = (1 - w) * fx;
    const top = (1 - h) * fy;
    return {
      left: fx + (left - fx) / zoom,
      top: fy + (top - fy) / zoom,
      width: w / zoom,
      height: h / zoom,
      density: 1 / (scale * zoom),
      whole: false,
    };
  };

  const sharpness = (density: number) =>
    density >= 2
      ? { cls: 'ok', text: 'sharp on all screens' }
      : density >= 1
        ? { cls: 'soft', text: 'softer on high-resolution screens (not enough detail for 2×)' }
        : { cls: 'bad', text: 'soft on all screens: the zoom goes beyond what the photo has' };

  document.querySelectorAll<HTMLElement>('.framing-section[data-placement]').forEach((section) => {
    const original = section.querySelector<HTMLElement>('.framing-original')!;
    const overlay = section.querySelector<HTMLElement>('.framing-overlay')!;
    const legend = section.querySelector<HTMLElement>('.framing-legend')!;
    const valuesOut = section.querySelector<HTMLElement>('[data-values]')!;
    const inputs = {
      x: section.querySelector<HTMLInputElement>('[data-control="x"]')!,
      y: section.querySelector<HTMLInputElement>('[data-control="y"]')!,
      z: section.querySelector<HTMLInputElement>('[data-control="z"]')!,
    };
    const frames = [...section.querySelectorAll<HTMLIFrameElement>('iframe')];
    const targets: Map<HTMLIFrameElement, HTMLImageElement> = new Map();

    // Optional starting values from the address, e.g. ?hero=50,20,1.5 (across, down, zoom).
    const fromUrl = new URLSearchParams(location.search).get(section.dataset.placement ?? '');
    if (fromUrl) {
      const [x, y, z] = fromUrl.split(',');
      if (x) inputs.x.value = x;
      if (y) inputs.y.value = y;
      if (z) inputs.z.value = z;
    }

    const current = (): Framing => ({
      x: Number(inputs.x.value),
      y: Number(inputs.y.value),
      z: Number(inputs.z.value),
    });

    const render = () => {
      const f = current();
      section.querySelector('[data-out="x"]')!.textContent = `${f.x}%`;
      section.querySelector('[data-out="y"]')!.textContent = `${f.y}%`;
      section.querySelector('[data-out="z"]')!.textContent = `${f.z.toFixed(2)}×`;

      const lines = [`${section.dataset.focusField}: '${f.x}% ${f.y}%'`];
      if (f.z > 1) lines.push(`${section.dataset.zoomField}: ${f.z.toFixed(2)}`);
      valuesOut.textContent = lines.join('\n');

      overlay.replaceChildren();
      legend.replaceChildren();
      const cross = document.createElement('div');
      cross.className = 'framing-cross';
      cross.style.left = `${f.x}%`;
      cross.style.top = `${f.y}%`;
      overlay.append(cross);

      frames.forEach((frame, i) => {
        const img = targets.get(frame);
        if (!img) return;
        img.style.setProperty('--focus', `${f.x}% ${f.y}%`);
        img.style.setProperty('--zoom', String(f.z));
        const area = visibleArea(img, f);
        const colour = COLOURS[i % COLOURS.length];
        const rect = document.createElement('div');
        rect.className = 'framing-rect';
        rect.style.cssText = `left:${pct(area.left)};top:${pct(area.top)};width:${pct(area.width)};height:${pct(area.height)};border-color:${colour}`;
        overlay.append(rect);

        const sharp = sharpness(area.density);
        const item = document.createElement('li');
        item.style.setProperty('--swatch', colour);
        const where = area.whole
          ? 'whole photo (framing not applied on phones)'
          : `shows ${pct(area.left)}–${pct(area.left + area.width)} across, ${pct(area.top)}–${pct(area.top + area.height)} down`;
        item.innerHTML = `<strong>${frame.dataset.view}</strong>: ${where} — <span class="v-${sharp.cls}">${sharp.text}</span>`;
        legend.append(item);
      });
    };

    frames.forEach((frame) => {
      frame.addEventListener('load', () => {
        const doc = frame.contentDocument;
        const img = doc
          ? (doc.querySelector(frame.dataset.target ?? '') as HTMLImageElement | null)
          : null;
        if (!img) return;
        // Scroll only inside the frame (scrollIntoView would also scroll this page).
        if (frame.dataset.scrollTo && frame.contentWindow) {
          const top = img.getBoundingClientRect().top + frame.contentWindow.scrollY;
          frame.contentWindow.scrollTo(0, Math.max(0, top - 200));
        }
        const ready = () => {
          targets.set(frame, img);
          render();
        };
        if (img.complete && img.naturalWidth) ready();
        else img.addEventListener('load', ready, { once: true });
      });
    });

    Object.values(inputs).forEach((input) => input.addEventListener('input', render));
    section.querySelector('[data-reset]')!.addEventListener('click', () => {
      inputs.x.value = original.dataset.savedX ?? '50';
      inputs.y.value = original.dataset.savedY ?? '50';
      inputs.z.value = original.dataset.savedZ ?? '1';
      render();
    });
    section.querySelector('[data-copy]')!.addEventListener('click', async (event) => {
      await navigator.clipboard.writeText(valuesOut.textContent ?? '');
      (event.currentTarget as HTMLButtonElement).textContent = 'Copied';
    });
    render();
  });

  // ---- In-article photos: shape + focus + zoom on the site's own gallery frame ----
  const RATIOS: Record<string, number | null> = {
    original: null,
    '3:2': 3 / 2,
    '4:3': 4 / 3,
    '1:1': 1,
    '4:5': 4 / 5,
    '16:9': 16 / 9,
    '2:1': 2,
  };
  // Phone (390px screen): the article column is 342px; frames follow the gallery's phone
  // widths (landscape and square across the column, portrait up to 260px).
  const PHONE_COLUMN = 342;
  const PHONE_PORTRAIT = 260;

  document.querySelectorAll<HTMLElement>('.framing-gallery').forEach((section) => {
    const frame = section.querySelector<HTMLElement>('.gallery-frame');
    const img = section.querySelector<HTMLImageElement>('.gallery-frame-image');
    if (!frame || !img) return;
    const original = section.querySelector<HTMLElement>('.framing-original')!;
    const overlay = section.querySelector<HTMLElement>('.framing-overlay')!;
    const legend = section.querySelector<HTMLElement>('.framing-legend')!;
    const valuesOut = section.querySelector<HTMLElement>('[data-values]')!;
    const pick = section.dataset.pick;
    // Insets: "side,size". On phones an inset is a centred photo at 70% of the column
    // (up to 340px), whatever its shape (Inset.astro).
    const [insetSide, insetSize] = section.dataset.inset?.split(',') ?? [];
    const inset = insetSide ? { side: insetSide, size: insetSize } : undefined;
    const phoneWidth = (kind: string) =>
      inset
        ? Math.round(Math.min(PHONE_COLUMN * 0.7, 340))
        : kind === 'portrait'
          ? PHONE_PORTRAIT
          : PHONE_COLUMN;
    const inputs = {
      x: section.querySelector<HTMLInputElement>('[data-control="x"]')!,
      y: section.querySelector<HTMLInputElement>('[data-control="y"]')!,
      z: section.querySelector<HTMLInputElement>('[data-control="z"]')!,
    };
    const shapes = [...section.querySelectorAll<HTMLInputElement>('[data-shape]')];
    const shapeValue = () => shapes.find((s) => s.checked)?.value ?? 'original';

    // Optional starting values from the address, e.g. ?photo2=40,30,1.2,4:5
    const index = [...document.querySelectorAll('.framing-gallery')].indexOf(section) + 1;
    const fromUrl = new URLSearchParams(location.search).get(`photo${index}`);
    if (fromUrl) {
      const [x, y, z, shape] = fromUrl.split(',');
      if (x) inputs.x.value = x;
      if (y) inputs.y.value = y;
      if (z) inputs.z.value = z;
      const match = shapes.find((s) => s.value === shape);
      if (match) match.checked = true;
    }

    const render = () => {
      const f: Framing = {
        x: Number(inputs.x.value),
        y: Number(inputs.y.value),
        z: Number(inputs.z.value),
      };
      const shape = shapeValue();
      const nw = img.naturalWidth || Number(img.getAttribute('width'));
      const nh = img.naturalHeight || Number(img.getAttribute('height'));
      const ratio = RATIOS[shape] ?? nw / nh;
      const kind = ratio > 1.01 ? 'landscape' : ratio < 0.99 ? 'portrait' : 'square';

      frame.style.aspectRatio = String(ratio);
      frame.style.setProperty('--focus', `${f.x}% ${f.y}%`);
      frame.style.setProperty('--zoom', String(f.z));
      // An inset's frame always fills the inset; a gallery frame's width follows its shape.
      if (!inset) {
        frame.classList.remove(
          'gallery-frame-landscape',
          'gallery-frame-portrait',
          'gallery-frame-square',
        );
        frame.classList.add(`gallery-frame-${kind}`);
      }

      section.querySelector('[data-out="x"]')!.textContent = `${f.x}%`;
      section.querySelector('[data-out="y"]')!.textContent = `${f.y}%`;
      section.querySelector('[data-out="z"]')!.textContent = `${f.z.toFixed(2)}×`;

      const untouched = shape === 'original' && f.x === 50 && f.y === 50 && f.z === 1;
      const framing = untouched
        ? ''
        : `${shape === 'original' ? '' : ` shape="${shape}"`} focus="${f.x}% ${f.y}%"${f.z > 1 ? ` zoom={${f.z.toFixed(2)}}` : ''}`;
      valuesOut.textContent = inset
        ? `<Inset side="${inset.side}"${inset.size === 'large' ? ' size="large"' : ''} pick={${pick}}${framing} />`
        : `<Gallery pick={[${pick}]}${framing} />`;

      const area = visibleArea(img, f);
      overlay.replaceChildren();
      const cross = document.createElement('div');
      cross.className = 'framing-cross';
      cross.style.left = `${f.x}%`;
      cross.style.top = `${f.y}%`;
      const rect = document.createElement('div');
      rect.className = 'framing-rect';
      rect.style.cssText = `left:${pct(area.left)};top:${pct(area.top)};width:${pct(area.width)};height:${pct(area.height)};border-color:${COLOURS[0]}`;
      overlay.append(rect, cross);

      const lines = [
        { label: `Desktop: ${img.offsetWidth}px wide`, density: area.density },
        {
          label: `Phone: ${phoneWidth(kind)}px wide`,
          density: (area.width * nw) / phoneWidth(kind),
        },
      ];
      legend.replaceChildren();
      const where = document.createElement('li');
      where.style.setProperty('--swatch', COLOURS[0]);
      where.textContent = `Shows ${pct(area.left)}–${pct(area.left + area.width)} across, ${pct(area.top)}–${pct(area.top + area.height)} down`;
      legend.append(where);
      lines.forEach((line) => {
        const sharp = sharpness(line.density);
        const item = document.createElement('li');
        item.classList.add('framing-legend-plain');
        item.innerHTML = `<strong>${line.label}</strong> — <span class="v-${sharp.cls}">${sharp.text}</span>`;
        legend.append(item);
      });
    };

    [...Object.values(inputs), ...shapes].forEach((el) => el.addEventListener('input', render));
    section.querySelector('[data-reset]')!.addEventListener('click', () => {
      inputs.x.value = original.dataset.savedX ?? '50';
      inputs.y.value = original.dataset.savedY ?? '50';
      inputs.z.value = original.dataset.savedZ ?? '1';
      const saved = shapes.find((s) => s.value === section.dataset.savedShape);
      if (saved) saved.checked = true;
      render();
    });
    section.querySelector('[data-copy]')!.addEventListener('click', async (event) => {
      await navigator.clipboard.writeText(valuesOut.textContent ?? '');
      (event.currentTarget as HTMLButtonElement).textContent = 'Copied';
    });
    // Measure once the column has laid out the frame (and again if the photo loads late).
    requestAnimationFrame(render);
    img.addEventListener('load', render);
  });
</script>

