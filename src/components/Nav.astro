---
import { ROUTES } from '../config/routes';

const links = [
  { label: 'About', href: ROUTES.about },
  { label: 'Awenvida', href: ROUTES.awenvida },
  { label: 'Beyond the Guidebook', href: ROUTES.beyondTheGuidebook },
  { label: 'The Uncommon Traveller', href: ROUTES.theUncommonTraveller },
  { label: 'Reservation for One', href: ROUTES.reservationForOne },
];
---

<header class="site-nav" aria-label="Primary navigation">
  <div class="brand-row">
    <a class="brand-wordmark" href={ROUTES.home}>Sokéfi</a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open navigation menu"
      data-menu-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="hero-intro" aria-label="Brand introduction">
    <p class="tagline">EXPERIENCE IT</p>
  </div>

  <div class="nav-row">
    <nav class="nav-links" aria-label="Section navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a class="subscribe-link" href={ROUTES.subscribe}>Subscribe</a>
  </div>

  <div id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
    <nav class="mobile-nav-links" aria-label="Mobile section navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="mobile-subscribe" href={ROUTES.subscribe}>Subscribe</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.hidden = expanded;
      menu.classList.toggle('is-open', !expanded);
    });
  }
</script>

<style>
  .site-nav {
    padding: 2rem 0 1.5rem;
    margin-bottom: 1rem;
  }

  .brand-row {
    margin-bottom: 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .hero-intro {
    margin-bottom: 1.4rem;
    max-width: 740px;
  }

  .brand-wordmark {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.3rem, 5vw, 5rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--teal);
    display: inline-block;
    line-height: 0.95;
    transition: opacity 160ms ease;
  }

  .brand-wordmark:hover,
  .brand-wordmark:focus-visible {
    opacity: 0.85;
  }

  .tagline {
    font-family: 'Lato', Arial, sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--teal);
    margin: 0;
  }

  .nav-row {
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 0.9rem;
    width: 100%;
    max-width: 100%;
    position: relative;
  }

  .nav-row::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--teal);
    border-radius: 999px;
  }

  .nav-links {
    display: flex;
    flex-wrap: nowrap;
    gap: 0 0.95rem;
    margin-right: 1rem;
    align-items: center;
    white-space: nowrap;
    flex: 1 1 auto;
  }

  .nav-links a {
    font-family: 'Lato', Arial, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--teal);
    padding-right: 0.95rem;
    border-right: 1px solid rgba(14, 143, 184, 0.25);
  }

  .nav-links a:last-child {
    border-right: 0;
    padding-right: 0;
  }

  .subscribe-link {
    font-family: 'Lato', Arial, sans-serif;
    font-size: var(--gold-button-size);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fffdf8;
    background: var(--amber);
    padding: 0.8rem 1.15rem;
    border-radius: 999px;
    margin-left: auto;
    flex-shrink: 0;
  }

  .menu-toggle {
    display: none;
    width: 46px;
    height: 46px;
    border: 1px solid rgba(14, 143, 184, 0.35);
    background: #ffffff;
    padding: 0;
    justify-content: center;
    align-items: center;
    gap: 5px;
    flex-direction: column;
    cursor: pointer;
  }

  .menu-toggle span {
    width: 20px;
    height: 2px;
    background: var(--teal);
    display: block;
  }

  .mobile-menu {
    margin-top: 0.75rem;
    border: 1px solid var(--border);
    background: #ffffff;
    padding: 0.9rem 1rem;
  }

  .mobile-nav-links {
    display: grid;
    gap: 0.6rem;
  }

  .mobile-nav-links a {
    font-family: 'Lato', Arial, sans-serif;
    font-size: 0.96rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--teal);
    padding: 0.35rem 0;
    border-bottom: 1px solid rgba(14, 143, 184, 0.15);
  }

  .mobile-nav-links a:last-child {
    border-bottom: 0;
  }

  .mobile-nav-links .mobile-subscribe {
    margin-top: 0.25rem;
    text-align: center;
    font-size: var(--gold-button-size);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fffdf8;
    background: var(--amber);
    border-bottom: 0;
    padding: 0.7rem 0.85rem;
  }

  @media (max-width: 1040px) {
    .nav-row {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .hero-intro {
      margin-bottom: 0.5rem;
    }

    .tagline {
      letter-spacing: 0.18em;
      font-size: 0.95rem;
    }
  }
</style>
