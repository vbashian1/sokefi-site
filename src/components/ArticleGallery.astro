---
import type { ImageMetadata } from 'astro';
import type { ArticleGalleryImage } from '../types/gallery';

type GallerySource = ImageMetadata | ArticleGalleryImage | string;
type ImageMeta = { src: string; width: number; height: number };

/** Frame shapes for a single photo: its own shape, or a crop to a set ratio. */
const SHAPES = {
  original: null,
  '3:2': 3 / 2,
  '4:3': 4 / 3,
  '1:1': 1,
  '4:5': 4 / 5,
} as const;
type Shape = keyof typeof SHAPES;

interface Props {
  pick?: number[];
  images?: GallerySource[];
  alt?: string[];
  /**
   * Framing for a single photo, set per placement (e.g. in the framing preview):
   * shape — "original", "3:2", "4:3", "1:1" or "4:5"; focus — focal point "across% down%";
   * zoom — enlargement around the focal point (1 = none). Always from the original photo.
   */
  shape?: Shape;
  focus?: string;
  zoom?: number;
}

const { pick, images, alt = [], shape, focus, zoom } = Astro.props;
if (shape !== undefined && !(shape in SHAPES)) {
  throw new Error(`Gallery shape "${shape}" must be one of: ${Object.keys(SHAPES).join(', ')}`);
}

// The validated `gallery:` frontmatter is published by the article page, because MDX
// only exposes RAW frontmatter to the body — `frontmatter.gallery` there is a list of
// unresolved path strings, not the ImageMetadata that astro:content produces.
const pool = Astro.locals?.articleGallery ?? [];
const selected: (GallerySource | undefined)[] =
  images ?? (pick ?? pool.map((_, i) => i)).map((i) => pool[i]);

const getImageMeta = (img: GallerySource | undefined): ImageMeta | null => {
  if (!img) return null;
  if (typeof img === 'string') return { src: img, width: 1600, height: 1000 };
  return { src: img.src, width: img.width, height: img.height };
};

const items = selected
  .map((img) => getImageMeta(img))
  .filter((meta): meta is ImageMeta => meta !== null)
  .map((meta, index, arr) => ({
    ...meta,
    landscape: meta.width >= meta.height,
    isLastOdd: arr.length % 2 === 1 && index === arr.length - 1,
    alt: alt[index] ?? `Photo ${index + 1}`,
  }));

// A single photo with any framing set is shown in a frame of the chosen shape; the photo
// fills it (object-fit cover) at the focal point and zoom. Frame width follows its shape:
// landscape across the column, portrait at the usual portrait size, square in between.
const framed = items.length === 1 && Boolean(shape || focus || zoom) ? items[0] : null;
const frameRatio = framed ? (SHAPES[shape ?? 'original'] ?? framed.width / framed.height) : 1;
const frameKind = frameRatio > 1.01 ? 'landscape' : frameRatio < 0.99 ? 'portrait' : 'square';
---

{
  framed && (
    <div class="article-gallery article-gallery-single">
      <div
        class:list={['gallery-frame', `gallery-frame-${frameKind}`]}
        style={`aspect-ratio: ${frameRatio}; --focus: ${focus ?? '50% 50%'}; --zoom: ${zoom ?? 1}`}
      >
        <img
          class="gallery-frame-image"
          src={framed.src}
          width={framed.width}
          height={framed.height}
          alt={framed.alt}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  )
}

{
  items.length === 1 && !framed && (
    <div class="article-gallery article-gallery-single">
      <img
        class:list={[
          'gallery-image',
          items[0].landscape ? 'gallery-image-landscape' : 'gallery-image-portrait',
        ]}
        src={items[0].src}
        width={items[0].width}
        height={items[0].height}
        alt={items[0].alt}
        loading="lazy"
        decoding="async"
      />
    </div>
  )
}

{
  items.length > 1 && (
    <div class="article-gallery article-gallery-grid">
      {items.map((img) => (
        <img
          class:list={['gallery-image', img.isLastOdd && 'gallery-image-full']}
          src={img.src}
          width={img.width}
          height={img.height}
          alt={img.alt}
          loading="lazy"
          decoding="async"
        />
      ))}
    </div>
  )
}

<style>
  /* Sits inline in the body flow, so it needs symmetric vertical margins.
     2.2rem matches the blockquote rhythm in the article body. */
  .article-gallery {
    margin: 2.2rem 0;
  }

  .gallery-image {
    display: block;
    border-radius: 0;
  }

  .gallery-image-landscape {
    width: 100%;
    height: auto;
  }

  .gallery-image-portrait {
    width: 50%;
    max-width: 340px;
    height: auto;
    margin: 0 auto;
  }

  .article-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .article-gallery-grid .gallery-image {
    width: 100%;
    height: auto;
  }

  .gallery-image-full {
    grid-column: 1 / -1;
  }

  /* Framed single photo (shape / focus / zoom): the frame clips, the photo fills it. */
  .gallery-frame {
    margin: 0 auto;
    overflow: hidden;
  }

  .gallery-frame-landscape {
    width: 100%;
  }

  .gallery-frame-square {
    width: 70%;
    max-width: 476px;
  }

  .gallery-frame-portrait {
    width: 50%;
    max-width: 340px;
  }

  .gallery-frame-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus, center center);
    transform: scale(var(--zoom, 1));
    transform-origin: var(--focus, center center);
  }

  @media (max-width: 700px) {
    .gallery-frame-square {
      width: 85%;
    }

    .gallery-frame-portrait {
      width: 70%;
    }
  }

  @media (max-width: 480px) {
    .gallery-frame-square {
      width: 100%;
    }

    .gallery-frame-portrait {
      width: 100%;
      max-width: 260px;
    }
  }

  @media (max-width: 700px) {
    .gallery-image-portrait {
      width: 70%;
    }
  }

  @media (max-width: 480px) {
    .article-gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery-image-full {
      grid-column: auto;
    }

    .gallery-image-portrait {
      width: 100%;
      max-width: 260px;
    }
  }
</style>
