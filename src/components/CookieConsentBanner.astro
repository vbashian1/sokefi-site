---
import { ROUTES } from '../config/routes';

const { cookieName = 'sokefi_cookie_consent' } = Astro.props;
---

<aside
  class="cookie-banner"
  aria-label="Cookie consent"
  data-cookie-banner
  data-cookie-name={cookieName}
>
  <p>
    We use cookies to understand site usage and improve your experience. Read our
    <a href={ROUTES.privacyPolicy}>Privacy Policy</a>.
  </p>
  <button type="button" class="cookie-accept" data-cookie-accept>Accept</button>
</aside>

<script>
  const banner = document.querySelector('[data-cookie-banner]');
  const button = banner?.querySelector('[data-cookie-accept]');

  if (banner && button) {
    button.addEventListener('click', () => {
      const cookieName = banner.getAttribute('data-cookie-name') ?? 'sokefi_cookie_consent';
      const maxAge = 60 * 60 * 24 * 180;
      document.cookie = `${cookieName}=accepted; Path=/; Max-Age=${maxAge}; SameSite=Lax; Secure`;
      banner.remove();
    });
  }
</script>

<style>
  .cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1200;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.2rem;
    padding: 0.95rem 1.2rem;
    border-top: 1px solid rgba(14, 143, 184, 0.2);
    background: #fffdf8;
    color: #17272b;
  }

  .cookie-banner p {
    margin: 0;
    font-family: 'Lato', Arial, sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.5;
  }

  .cookie-banner a {
    color: #0c7fa2;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .cookie-accept {
    border: 0;
    background: #c9a227;
    color: #fffdf8;
    font-family: 'Lato', Arial, sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.72rem 1.1rem;
    border-radius: 0;
    cursor: pointer;
  }

  .cookie-accept:hover,
  .cookie-accept:focus-visible {
    filter: brightness(0.96);
  }

  @media (max-width: 640px) {
    .cookie-banner {
      padding: 0.9rem 0.95rem;
      gap: 0.72rem;
    }

    .cookie-banner p {
      font-size: 0.75rem;
      letter-spacing: 0.07em;
    }

    .cookie-accept {
      width: 100%;
      text-align: center;
    }
  }
</style>
