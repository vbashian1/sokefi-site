---
// Pull quote: a line from the article set large to break up the text. Three styles:
//   variant="bar"     — the existing amber-bar quote, in the column (the default)
//   variant="display" — large and centred, breaking out wider than the column
//   variant="side"    — set in the margin beside the text on wide screens (side="left" or
//                       "right"); on narrower screens it becomes the amber-bar quote
// Each callout line also appears in the body text, so the wording is never new — and the
// quote is hidden from screen readers (aria-hidden) so the line isn't read out twice.
//   <PullQuote variant="display">Ancient and modern, literally side by side.</PullQuote>
interface Props {
  variant?: 'bar' | 'display' | 'side';
  side?: 'left' | 'right';
}

const { variant = 'bar', side = 'right' } = Astro.props;
if (!['bar', 'display', 'side'].includes(variant)) {
  throw new Error(`PullQuote variant "${variant}" must be "bar", "display" or "side"`);
}
---

{
  variant === 'bar' && (
    <blockquote class="pullquote-bar" aria-hidden="true">
      <p>
        <slot />
      </p>
    </blockquote>
  )
}
{
  variant === 'display' && (
    <aside class="pullquote-display" aria-hidden="true">
      <p>
        <slot />
      </p>
    </aside>
  )
}
{
  variant === 'side' && (
    <aside class:list={['pullquote-side', `pullquote-side-${side}`]} aria-hidden="true">
      <p>
        <slot />
      </p>
    </aside>
  )
}

<style>
  /* Large centred quote, wider than the text column, between two short amber rules. */
  .pullquote-display {
    clear: both;
    margin: 3rem 0;
    padding: 1.6rem 0;
    text-align: center;
  }

  .pullquote-display::before,
  .pullquote-display::after {
    content: '';
    display: block;
    width: 64px;
    height: 2px;
    margin: 0 auto;
    background: var(--amber);
  }

  .pullquote-display p {
    margin: 1.4rem auto;
    max-width: 22em;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--brand-teal);
  }

  @media (min-width: 901px) {
    .pullquote-display {
      width: min(900px, calc(100vw - 3rem));
      margin-left: calc(50% - min(450px, 50vw - 1.5rem));
    }
  }

  /* Side quote: on narrow screens, the amber-bar quote in the column. */
  .pullquote-side {
    margin: 2.2rem 0;
    padding-left: 1.35rem;
    border-left: 2px solid var(--amber);
  }

  .pullquote-side p {
    margin: 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.3rem, 2vw, 1.55rem);
    font-weight: 600;
    line-height: 1.5;
    color: var(--amber);
  }

  /* Wide screens: lifted into the margin beside the column (the column is 680px inside a
     1152px page, leaving ~236px either side), so the text runs at full width beside it. */
  @media (min-width: 1180px) {
    .pullquote-side {
      width: 200px;
      margin-top: 0.3rem;
      margin-bottom: 1rem;
      padding: 0.9rem 0 0;
      border-left: 0;
      border-top: 2px solid var(--amber);
    }

    .pullquote-side-right {
      float: right;
      margin-right: -236px;
      margin-left: 0;
    }

    .pullquote-side-left {
      float: left;
      margin-left: -236px;
      margin-right: 0;
    }

    .pullquote-side p {
      font-size: 1.15rem;
      line-height: 1.45;
    }
  }
</style>
