---
// Pull quote: a line from the article set large to break up the text. Three styles:
//   variant="bar"     — the existing amber-bar quote, in the column (the default)
//   variant="display" — large and centred, within the column
//   variant="side"    — set in the margin beside the text on wide screens (side="left" or
//                       "right"); on narrower screens it becomes the amber-bar quote
// Each callout line also appears in the body text, so the wording is never new — and the
// quote is hidden from screen readers (aria-hidden) so the line isn't read out twice.
//   <PullQuote variant="display">Ancient and modern, literally side by side.</PullQuote>
interface Props {
  variant?: 'bar' | 'display' | 'side';
  side?: 'left' | 'right';
}

const { variant = 'bar', side = 'right' } = Astro.props;
if (!['bar', 'display', 'side'].includes(variant)) {
  throw new Error(`PullQuote variant "${variant}" must be "bar", "display" or "side"`);
}

// A quote written over several lines in the article arrives wrapped in its own paragraph,
// which would nest inside the quote's paragraph and lose the quote style — so unwrap it.
const unwrapped = (await Astro.slots.render('default')).replace(/<\/?p>/g, '').trim();
// Lines broken by hand (<br />) each wrap evenly on their own, so a long last line splits
// into two even lines instead of leaving a word or two alone.
const lines = unwrapped.split(/<br\s*\/?>/i).map((line) => line.trim());
const quote =
  lines.length > 1
    ? lines.map((line) => `<span class="pullquote-line">${line}</span>`).join('')
    : unwrapped;
---

{
  variant === 'bar' && (
    <blockquote class="pullquote-bar" aria-hidden="true">
      <p set:html={quote} />
    </blockquote>
  )
}
{
  variant === 'display' && (
    <aside class="pullquote-display" aria-hidden="true">
      <p set:html={quote} />
    </aside>
  )
}
{
  variant === 'side' && (
    <aside class:list={['pullquote-side', `pullquote-side-${side}`]} aria-hidden="true">
      <p set:html={quote} />
    </aside>
  )
}

<style>
  /* Large centred quote between two short amber rules, within the text column, with the
     same space above and below as the amber-bar quote (Veronica, 2026-10-21). */
  .pullquote-display {
    clear: both;
    margin: 2.2rem 0;
    text-align: center;
  }

  .pullquote-display::before,
  .pullquote-display::after {
    content: '';
    display: block;
    width: 64px;
    height: 2px;
    margin: 0 auto;
    background: var(--amber);
  }

  .pullquote-display p {
    margin: 1rem auto;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--brand-teal);
    text-wrap: balance;
  }

  /* A line broken by hand: its own block, wrapped evenly on its own. */
  :global(.pullquote-line) {
    display: block;
    text-wrap: balance;
  }

  /* Side quote: on narrow screens, the amber-bar quote in the column. */
  .pullquote-side {
    margin: 2.2rem 0;
    padding-left: 1.35rem;
    border-left: 2px solid var(--amber);
  }

  .pullquote-side p {
    margin: 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.3rem, 2vw, 1.55rem);
    font-weight: 600;
    line-height: 1.5;
    color: var(--amber-text);
  }

  /* Wide screens: lifted into the margin beside the column (the column is 680px inside a
     1152px page, leaving ~236px either side), so the text runs at full width beside it. */
  @media (min-width: 1180px) {
    .pullquote-side {
      width: 210px;
      margin-top: 0.3rem;
      margin-bottom: 1rem;
      padding: 0.9rem 0 0;
      border-left: 0;
      border-top: 2px solid var(--amber);
    }

    .pullquote-side-right {
      float: right;
      margin-right: -236px;
      margin-left: 0;
    }

    .pullquote-side-left {
      float: left;
      margin-left: -236px;
      margin-right: 0;
    }

    /* Teal Playfair, set large enough to hold its own beside the column. */
    .pullquote-side p {
      font-size: 1.45rem;
      line-height: 1.35;
      color: var(--brand-teal);
    }
  }
</style>
