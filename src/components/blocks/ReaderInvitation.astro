---
// Reader invitation: a panel at the end of a piece inviting readers to respond privately
// (Veronica, 2026-10-15: a private form, not public comments). A teal Playfair heading,
// the piece's own question in italics, and a button styled like the Details-box buttons.
// Reusable — Blues Highway and the Q&A will use it with their own question:
//   <ReaderInvitation>What does it mean for you to turn 60 — …?</ReaderInvitation>
// heading and button default to "We’d like to hear from you." and "Tell us".
// The button matches the home page's "Read our story" button exactly (brand gold, off-white
// Lato capitals), so it reads as a site action, not one of the outlined booking buttons.
//
// NOTE: the private response form is still to be built. Until it is, the button is a
// placeholder: shown but disabled (not clickable, no link). When the form exists, give
// the button its link here, once, for every piece that uses the panel.
interface Props {
  heading?: string;
  button?: string;
}

const { heading = 'We’d like to hear from you.', button = 'Tell us' } = Astro.props;
---

<aside class="reader-invitation" aria-label={heading}>
  <h2 class="reader-invitation-heading">{heading}</h2>
  <div class="reader-invitation-question">
    <slot />
  </div>
  <button class="reader-invitation-button" type="button" disabled>{button}</button>
</aside>

<style>
  .reader-invitation {
    clear: both;
    margin: 2.6rem 0 0.5rem;
    padding: 1.6rem 1.6rem 1.75rem;
    border-top: 2px solid var(--amber);
    background: color-mix(in srgb, var(--brand-teal) 5%, #ffffff);
    text-align: center;
  }

  /* :global(.article-body) so these beat the article's own heading and paragraph styles.
     Balanced wrapping keeps the lines roughly even at every width. */
  :global(.article-body) .reader-invitation .reader-invitation-heading {
    clear: none;
    margin: 0 0 0.6rem;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.35rem, 2.2vw, 1.6rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--brand-teal);
    text-wrap: balance;
  }

  :global(.article-body) .reader-invitation-question :global(p) {
    margin: 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.1rem, 1.7vw, 1.22rem);
    font-style: italic;
    line-height: 1.5;
    color: var(--brand-teal);
    text-wrap: balance;
  }

  /* Exactly the home page's "Read our story" button (.brand-intro-button in
     src/pages/index.astro): brand gold, off-white Lato capitals, same padding and size. */
  .reader-invitation-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.2rem;
    border-radius: 999px;
    border: 0;
    padding: 0.78rem 1.34rem;
    font-family: 'Lato', Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    /* A <button> doesn't inherit line height like the link does: set the link's 1.7. */
    line-height: 1.7;
    text-transform: uppercase;
    color: #fffdf8;
    background: #c9a227;
    white-space: nowrap;
  }

  /* Placeholder until the form exists: looks like the finished button, but isn't clickable. */
  .reader-invitation-button:disabled {
    cursor: default;
    opacity: 1;
  }
</style>
