---
// One photo in a frame of a chosen shape, filled from the ORIGINAL file at the saved focal
// point and zoom (object-fit cover; nothing is pre-cropped). Used by <Gallery> and every
// layout block, so a placement's saved crop looks the same wherever it is used.
//
// fit="gallery": the frame's width follows its shape (landscape across the column,
//   portrait at the usual portrait size, square in between), with phone sizes.
// fit="fill": the frame fills whatever its block gives it (full-width, wide, pair, inset).
import type { ImageMetadata } from 'astro';
import type { ArticleGalleryImage } from '../../types/gallery';
import { frameKind, frameRatio, isShape, type Shape } from '../../utils/framing';
import { responsiveImage, type Slot } from '../../utils/responsiveImage';

type Source = ImageMetadata | ArticleGalleryImage | { src: string; width: number; height: number };

interface Props {
  /** The photo itself, or `pick` to use the article's gallery photo by index. */
  image?: Source;
  pick?: number;
  shape?: Shape;
  focus?: string;
  zoom?: number;
  alt?: string;
  fit?: 'gallery' | 'fill';
  loading?: 'lazy' | 'eager';
  /** How wide the frame is on each screen (for the web-sized copies). Blocks that place the
      frame at their own width (insets, wide, full-bleed, pairs) pass theirs; the frame adds
      its crop and zoom. Defaults to the article column, by frame shape. */
  slots?: Omit<Slot, 'cover' | 'frameRatio' | 'zoom'>[];
}

const {
  image,
  pick,
  shape,
  focus,
  zoom,
  alt = '',
  fit = 'gallery',
  loading = 'lazy',
  slots,
} = Astro.props;
if (shape !== undefined && !isShape(shape)) {
  throw new Error(`Photo shape "${shape}" must be one of: original, 3:2, 4:3, 1:1, 4:5`);
}

const photo = image ?? (pick !== undefined ? Astro.locals?.articleGallery?.[pick] : undefined);
if (!photo) {
  throw new Error(`No photo for pick ${pick}: the article's gallery has no image at that index`);
}

const ratio = frameRatio(shape, photo.width, photo.height);
const kind = frameKind(ratio);
const sizeClass = fit === 'fill' ? 'gallery-frame-fill' : `gallery-frame-${kind}`;

// Frame widths in the article column, matching the CSS below (column 680px; phones the
// column less its gutters).
const COLUMN = 'calc(100vw - 2rem)';
const defaultSlots: Omit<Slot, 'cover' | 'frameRatio' | 'zoom'>[] =
  fit === 'fill' || kind === 'landscape'
    ? [
        { media: '(max-width: 720px)', width: COLUMN, maxPx: 720 },
        { width: '680px', maxPx: 680 },
      ]
    : kind === 'square'
      ? [
          { media: '(max-width: 480px)', width: COLUMN, maxPx: 480 },
          { media: '(max-width: 700px)', width: `calc(${COLUMN} * 0.85)`, maxPx: 600 },
          { width: '476px', maxPx: 476 },
        ]
      : [
          { media: '(max-width: 480px)', width: `min(${COLUMN}, 260px)`, maxPx: 260 },
          { media: '(max-width: 700px)', width: `calc(${COLUMN} * 0.7)`, maxPx: 490 },
          { width: '340px', maxPx: 340 },
        ];
const web = responsiveImage(
  photo,
  (slots ?? defaultSlots).map((slot) => ({ ...slot, cover: true, frameRatio: ratio, zoom })),
);
---

<div
  class:list={['gallery-frame', sizeClass]}
  style={`aspect-ratio: ${ratio}; --focus: ${focus ?? '50% 50%'}; --zoom: ${zoom ?? 1}`}
>
  <img
    class="gallery-frame-image"
    src={web.src}
    srcset={web.srcset}
    sizes={web.sizes}
    width={photo.width}
    height={photo.height}
    alt={alt}
    loading={loading}
    decoding="async"
  />
</div>

<style>
  .gallery-frame {
    margin: 0 auto;
    overflow: hidden;
  }

  .gallery-frame-fill,
  .gallery-frame-landscape {
    width: 100%;
  }

  .gallery-frame-square {
    width: 70%;
    max-width: 476px;
  }

  .gallery-frame-portrait {
    width: 50%;
    max-width: 340px;
  }

  .gallery-frame-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus, center center);
    transform: scale(var(--zoom, 1));
    transform-origin: var(--focus, center center);
  }

  @media (max-width: 700px) {
    .gallery-frame-square {
      width: 85%;
    }

    .gallery-frame-portrait {
      width: 70%;
    }
  }

  @media (max-width: 480px) {
    .gallery-frame-square {
      width: 100%;
    }

    .gallery-frame-portrait {
      width: 100%;
      max-width: 260px;
    }
  }
</style>
