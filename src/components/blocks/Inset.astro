---
// Inset photo: a smaller photo beside the text, with the text flowing around it, on the
// left or right — placed only where chosen. Uses the placement's saved crop.
// Rules (checked at build, src/plugins/layout-rules.mjs): an inset sits within a run of text
// (straight after a paragraph, never at the start of a section) and is at least 3
// paragraphs from any other inset. As a safeguard it also starts below any earlier float,
// and headings and wide blocks start below it.
// On phones it is a centred photo in the column, with no wrap.
//   <Inset pick={0} side="left" shape="4:3" focus="60% 59%" zoom={1.13} />
import FramedImage from './FramedImage.astro';
import PhotoCredit from './PhotoCredit.astro';
import type { Shape } from '../../utils/framing';

interface Props {
  side?: 'left' | 'right';
  /** 'large': about half the column (55%, up to 400px) for a photo that needs more room. */
  size?: 'standard' | 'large';
  pick?: number;
  image?: { src: string; width: number; height: number };
  shape?: Shape;
  focus?: string;
  zoom?: number;
  alt?: string;
  /** Reader credit for a photo whose licence requires one (see PhotoCredit). */
  credit?: string;
}

const { side = 'left', size = 'standard', credit, ...photo } = Astro.props;
if (side !== 'left' && side !== 'right') {
  throw new Error(`Inset side "${side}" must be "left" or "right"`);
}
---

<figure
  class:list={['block-inset', `block-inset-${side}`, size === 'large' && 'block-inset-large']}
>
  <FramedImage
    {...photo}
    fit="fill"
    slots={[
      // Phones: a centred photo, 70% of the column (up to 340px). Above: 42% / 55% of the
      // column, up to 300px / 400px (large).
      { media: '(max-width: 700px)', width: 'min(calc((100vw - 2rem) * 0.7), 340px)', maxPx: 340 },
      size === 'large' ? { width: '400px', maxPx: 400 } : { width: '300px', maxPx: 300 },
    ]}
  />
  <PhotoCredit credit={credit} />
</figure>

<style>
  .block-inset {
    clear: both;
    width: 42%;
    max-width: 300px;
    /* Top edge level with the top of the first line of text beside it (measured). */
    margin-top: 0.475rem;
    margin-bottom: 1rem;
  }

  .block-inset-large {
    width: 55%;
    max-width: 400px;
  }

  .block-inset-left {
    float: left;
    margin-left: 0;
    margin-right: 1.5rem;
  }

  .block-inset-right {
    float: right;
    margin-left: 1.5rem;
    margin-right: 0;
  }

  @media (max-width: 700px) {
    .block-inset {
      float: none;
      width: 70%;
      max-width: 340px;
      margin: 2rem auto;
    }
  }
</style>
