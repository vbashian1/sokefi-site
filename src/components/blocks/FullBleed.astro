---
// Full-bleed photo: breaks out of the text column to the full width of the screen, edge to
// edge, for big scene-setting moments. Uses the placement's saved crop (shape, focus, zoom)
// on the original photo. On phones it simply spans the screen.
//   <FullBleed pick={3} shape="2:1" focus="34% 69%" />  (16:9 or 2:1; at most one per article)
import FramedImage from './FramedImage.astro';
import { WIDE_SHAPES, type Shape } from '../../utils/framing';

interface Props {
  pick?: number;
  image?: { src: string; width: number; height: number };
  shape?: Shape;
  focus?: string;
  zoom?: number;
  alt?: string;
}

const props = Astro.props;
// Wide shapes only, and never taller than the banner (see layout rules).
if (!(WIDE_SHAPES as readonly string[]).includes(props.shape ?? '')) {
  throw new Error('<FullBleed> needs shape="16:9" or shape="2:1"');
}
---

<figure class="block-full-bleed">
  <FramedImage {...props} fit="fill" slots={[{ width: '100vw', maxPx: 2560 }]} />
</figure>

<style>
  /* Never taller than the article banner: the frame keeps its width and is cut to the
     banner height around the focal point. */
  .block-full-bleed :global(.gallery-frame) {
    max-height: var(--banner-height);
  }

  .block-full-bleed {
    clear: both;
    width: 100vw;
    margin: 2.8rem 0 2.8rem calc(50% - 50vw);
  }
</style>
