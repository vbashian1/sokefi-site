{
  "name": "sokefi-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.ts,.astro --max-warnings=0",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts,astro,json,md}": [
      "prettier --write"
    ],
    "*.{js,ts,astro}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "astro": "^7.3.8",
    "prettier": "^2.8.8",
    "prettier-plugin-astro": "^0.14.0",
    "eslint": "^8.50.0",
    "@typescript-eslint/parser": "^6.9.0",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "eslint-plugin-astro": "^1.1.0",
    "astro-eslint-parser": "^1.3.0",
    "eslint-config-prettier": "^8.8.0",
    "typescript": "~5.3.3",
    "@astrojs/check": "^0.9.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8"
  }
}
