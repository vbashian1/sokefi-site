{
  "name": "sokefi-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.ts,.astro --max-warnings=0",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro,json,md,mdx}": [
      "prettier --write"
    ],
    "*.{js,mjs,ts,astro}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "astro": "^7.3.8",
    "astro-eslint-parser": "^1.3.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-astro": "^1.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~5.3.3"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.8",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.14",
    "marked": "^18.0.9",
    "marked-smartypants": "^1.1.12"
  }
}
